{
  "name": "cs-skill-tree",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run data && vite",
    "data": "node --no-warnings=ExperimentalWarning scripts/data.ts",
    "test": "npm run data && node --no-warnings=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run data && npm run typecheck && vite build --base /cs-skill-tree/tree/ --outDir dist/tree --emptyOutDir && node --no-warnings=ExperimentalWarning scripts/pages.ts",
    "preview": "vite preview --outDir dist --base /cs-skill-tree/"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "simple-icons": "^15.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
