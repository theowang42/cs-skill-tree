{
  "name": "cs-skill-tree",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:build && vite",
    "dev:api": "npm run db:build && node scripts/dev-api.ts",
    "api": "node --no-warnings=ExperimentalWarning server/index.ts",
    "db": "node --no-warnings=ExperimentalWarning scripts/db.ts",
    "db:build": "npm run db -- build --export",
    "db:check": "npm run db -- check",
    "db:export": "npm run db -- export",
    "test": "node --no-warnings=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run db:build && npm run typecheck && vite build --base ./ && cp docs/og.jpg dist/og.jpg",
    "preview": "vite preview --base ./"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "simple-icons": "^15.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
